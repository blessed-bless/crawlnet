# Redis frontier (required for cluster mode)
CRAWLNET_REDIS_URL=redis://localhost:6379/0

# Results DB: SQLite locally, Postgres in docker-compose
CRAWLNET_DB_URL=sqlite+aiosqlite:///crawlnet.db

# Directory with YAML spiders
CRAWLNET_SPIDERS_DIR=spiders

# Redis key prefix
CRAWLNET_PREFIX=cn

# Seconds a claim may stay in inflight before reaper reclaim
CRAWLNET_INFLIGHT_TIMEOUT=120

# Telegram: BotFather token + comma-separated user ids (required or bot will not start)
CRAWLNET_TG_TOKEN=
CRAWLNET_TG_ALLOWED=

# Dashboard HTTP Basic password (required if dashboard binds beyond localhost)
CRAWLNET_DASHBOARD_PASSWORD=
